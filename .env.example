# ── Render service environment variables ──────────────────────────────────────
# Copy to .env for local development. Never commit .env to version control.

# Shared secret for Shopify webhook HMAC validation
SHOPIFY_WEBHOOK_SECRET=

# Shared secret for the /render endpoint (checked by mapvibe-studio)
RENDER_SECRET=

# Vercel Blob storage token (for PNG upload after render)
BLOB_READ_WRITE_TOKEN=

# Printful credentials
PRINTFUL_KEY=
PRINTFUL_STORE_ID=

# Gelato API key
GELATO_KEY=

# ── Fulfillment failure alerting (all optional) ───────────────────────────────

# HTTP POST target for webhook alerts (Slack, n8n, Zapier, etc.)
ALERT_WEBHOOK_URL=

# Email address to receive [FULFILL-FAIL] alerts
ALERT_EMAIL=hi@mapvibestudio.com

# Resend API key — required when ALERT_EMAIL is set
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=

# Sender address for alert emails (default: alerts@mapvibestudio.com)
# Must be verified in your Resend sending domain (mapvibestudio.com)
ALERT_FROM_EMAIL=alerts@mapvibestudio.com
