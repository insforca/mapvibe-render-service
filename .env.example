# -- Render service environment variables ----------------------------------------------
# Copy to .env for local development. Never commit .env to version control.

# Shared secret for Shopify webhook HMAC validation
SHOPIFY_WEBHOOK_SECRET=

# Shared secret for the /render endpoint (checked by mapvibe-studio)
RENDER_SECRET=

# Vercel Blob storage token (for PNG upload after render)
BLOB_READ_WRITE_TOKEN=

# Printful credentials
PRINTFUL_KEY=
PRINTFUL_STORE_ID=

# Gelato API key
GELATO_KEY=

# -- Fulfillment failure alerting (all optional) ----------------------------------

# HTTP POST target for webhook alerts (Slack, n8n, Zapier, etc.)
ALERT_WEBHOOK_URL=

# Email address to receive [FULFILL-FAIL] alerts
ALERT_EMAIL=hi@mapvibestudio.com

# Resend API key -- required when ALERT_EMAIL is set
RESEND_API_KEY=

# Sender address for alert emails (default: alerts@mapvibestudio.com)
ALERT_FROM_EMAIL=alerts@mapvibestudio.com

# -- OSM Python renderer ---------------------------------------------------------
# RENDER_ENGINE=osm   -> use Python/OSMnx pipeline (maptoposter) for fulfillment
# RENDER_ENGINE=maplibre (default) -> keep native GL pipeline
RENDER_ENGINE=maplibre

# Path to the Python binary inside the venv
# MAPVIBE_PYTHON=/opt/mapvibe-py/bin/python3

# OSM data cache directory (default: /tmp/mapvibe-osm-cache)
# CACHE_DIR=/data/osm-cache

# -- Cloudflare R2 graph cache (Phase 1 persistent cache) -------------------------
# When set, OSMnx graph data is mirrored to R2 and survives Railway restarts.
# Create an R2 bucket named "mapvibe-graph-cache" and an API token with
# Object Read & Write permissions in your Cloudflare dashboard.

# Cloudflare account ID (from the Cloudflare dashboard sidebar)
R2_ACCOUNT_ID=

# R2 API token access key (from R2 -> Manage R2 API tokens)
R2_ACCESS_KEY_ID=

# R2 API token secret key
R2_SECRET_ACCESS_KEY=

# R2 bucket name (default: mapvibe-graph-cache)
# R2_BUCKET_NAME=mapvibe-graph-cache
